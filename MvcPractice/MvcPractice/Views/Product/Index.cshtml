@model IEnumerable<MvcPractice.Models.Product>

<h1>Product List</h1>
<a href="/Product/Create">Add New Product</a>

<table border="1">
    <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Price</th>
        <th>Actions</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Name</td>
            <td>@item.Price</td>
            <td>
                <a href="/Product/Edit/@item.Id">Edit</a> |
                <a href="/Product/Delete/@item.Id">Delete</a>
            </td>
        </tr>
    }
</table>
